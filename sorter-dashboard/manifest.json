{
  "manifest_version": 3,
  "name": "Sorter Dashboard - Cross-belt Contagem",
  "version": "1.20.35",
  "description": "Dashboard dinâmico do sorter: processamento do dia, rejeitos, saídas, rotas e induções ofensoras.",
  "action": {
    "default_title": "Abrir dashboard do sorter",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "alarms",
    "scripting",
    "tabs",
    "notifications"
  ],
  "host_permissions": [
    "http://10.1.164.9/*",
    "https://open.feishu.cn/*",
    "https://open.larksuite.com/*",
    "https://hooks.slack.com/*",
    "https://discord.com/*",
    "https://*.webhook.office.com/*",
    "https://*.office.com/*",
    "https://*.logic.azure.com/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}